# --- Frontend (browser) variables: these are exposed into the client bundle via
# vite's envPrefix, so set them in Vercel Project Settings -> Environment
# Variables for Production / Preview / Development.
#
# Neon Postgres connection string (pooler endpoint). Used by the browser-side
# @neondatabase/serverless driver.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.c-7.region.aws.neon.tech/DB
#
# Neon Object Storage S3-compatible base URL, no trailing slash. This is the
# value of AWS_ENDPOINT_URL_S3 in Neon's credential — Neon's S3 UI calls it
# "S3 Endpoint"; the frontend's own variable is named NEON_STORAGE_ENDPOINT.
# Used to build public-read URLs for reference images:
#   NEON_STORAGE_ENDPOINT/snake-image/reference/<path>
NEON_STORAGE_ENDPOINT=https://br-xxx.storage.c-7.region.aws.neon.tech

# --- scripts/upload_all.mjs only (one-off data/image upload, NOT used at runtime
# or on Vercel). These are the S3 credentials Neon generates per-project; fill
# from Neon -> Object Storage -> Generate S3-compatible access credential.
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxx.c-7.region.aws.neon.tech/DB
# AWS_ENDPOINT_URL_S3=https://br-xxx.storage.c-7.region.aws.neon.tech
# AWS_ACCESS_KEY_ID=<key id>
# AWS_SECRET_ACCESS_KEY=<secret>
# AWS_REGION=us-east-2
# NEON_BRANCH=production
