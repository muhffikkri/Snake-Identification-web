# Neon Postgres connection string (pooler endpoint). Vercel exposes VITE_-prefixed
# keys into the client bundle at build time; DATABASE_URL_UNPOOLED is the direct
# connection used by the browser-side Neon serverless driver.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.c-1.region.aws.neon.tech/DB
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxx.c-1.region.aws.neon.tech/DB
# Neon Object Storage S3-compatible base URL (no trailing slash). Used to build
# presigned-free public read URLs for reference images.
NEON_STORAGE_ENDPOINT=https://br-xxx.storage.c-1.region.aws.neon.tech
# Neon branch name (informational, used by scripts/upload_all.mjs)
NEON_BRANCH=production
